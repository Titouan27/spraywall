rules_version = '2';
// Lecture : tout le monde (même sans connexion).
// Écriture : uniquement les comptes connectés avec un pseudo, et seulement sur leurs propres blocs.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function myProfile() { return /databases/$(database)/documents/users/$(uid()); }
    function hasName() { return signedIn() && exists(myProfile()); }
    function myName() { return get(myProfile()).data.name; }

    // ---- Pseudos : uniques et définitifs ----
    // users/{uid} et usernames/{pseudo en minuscules} sont créés ensemble et ne peuvent plus changer.
    match /usernames/{key} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid']) && request.resource.data.uid == uid()
        && !exists(myProfile())
        && getAfter(myProfile()).data.key == key;
      allow update, delete: if false;
    }
    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn() && userId == uid()
        && request.resource.data.keys().hasOnly(['name', 'key'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 20
        && request.resource.data.key == request.resource.data.name.lower()
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.key)).data.uid == uid();
      allow update, delete: if false;
    }

    // ---- Blocs ----
    match /problems/{id} {
      allow read: if true;
      allow create: if hasName() && isValidProblem(request.resource.data, id)
        && request.resource.data.authorUid == uid() && request.resource.data.author == myName();
      allow update: if hasName() && isValidProblem(request.resource.data, id)
        && resource.data.authorUid == uid()
        && request.resource.data.authorUid == uid() && request.resource.data.author == myName()
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if signedIn() && resource.data.authorUid == uid();
    }
    function isValidProblem(p, id) {
      return p.keys().hasOnly(['id', 'name', 'grade', 'description', 'author', 'authorUid', 'circles', 'createdAt', 'updatedAt'])
        && p.id == id
        && p.name is string && p.name.size() > 0 && p.name.size() <= 60
        && p.grade is string && p.grade.size() <= 4
        && p.description is string && p.description.size() <= 1000
        && p.circles is list && p.circles.size() > 0 && p.circles.size() <= 150
        && p.createdAt is int && p.updatedAt is int;
    }
    // ---- Ascensions : publiques, une par grimpeur et par bloc (id = uid_blocId) ----
    match /ascents/{id} {
      allow read: if true;
      allow create, update: if hasName() && isValidAscent(request.resource.data, id)
        && request.resource.data.uid == uid() && request.resource.data.user == myName();
      // la sienne, ou celles de son bloc (quand l'auteur supprime le bloc)
      allow delete: if signedIn() && (resource.data.uid == uid()
        || get(/databases/$(database)/documents/problems/$(resource.data.problemId)).data.authorUid == uid());
    }
    function isValidAscent(a, id) {
      return a.keys().hasOnly(['id', 'uid', 'user', 'problemId', 'grade', 'date', 'createdAt'])
        && a.id == id && id == uid() + '_' + a.problemId
        && a.grade in ['3', '4', '4+', '5', '5+', '6A', '6A+', '6B', '6B+', '6C', '6C+', '7A', '7A+', '7B', '7B+', '7C', '7C+', '8A', '8A+', '8B', '8B+', '8C', '8C+']
        && a.date is string && a.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && a.createdAt is int
        && exists(/databases/$(database)/documents/problems/$(a.problemId));
    }

    // ---- Projets : privés, chacun ne voit et ne gère que les siens (id = uid_blocId) ----
    match /projects/{id} {
      allow read, delete: if signedIn() && resource.data.uid == uid();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['id', 'uid', 'problemId', 'createdAt'])
        && request.resource.data.id == id && request.resource.data.uid == uid()
        && id == uid() + '_' + request.resource.data.problemId
        && request.resource.data.createdAt is int
        && exists(/databases/$(database)/documents/problems/$(request.resource.data.problemId));
      allow update: if false;
    }

    // tout le reste est interdit
  }
}
